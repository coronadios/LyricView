# LyricView example configuration
# Uncomment a theme line to enable it, or use --theme:theme in the CLI.
# LYRICVIEW_THEME=minimal
# LYRICVIEW_THEME=deep
# LYRICVIEW_THEME=aurora
# LYRICVIEW_THEME=sunset
# LYRICVIEW_THEME=midnight
# LYRICVIEW_THEME=glass

# Extra visual controls
LYRICVIEW_WINDOW_TITLE=LyricView
LYRICVIEW_SHOW_TITLE=true
LYRICVIEW_FONT_SIZE=30

# Example custom file selection
# LYRICVIEW_FILE=lyric-test.txt
